# ─── Database ───────────────────────────────────────────────────────────────
# Neon Postgres (production) or local Postgres (development)
DATABASE_URL=postgres://djq:djqsecret@localhost:5432/disjobqueue?sslmode=disable

# ─── Cache / Lock ────────────────────────────────────────────────────────────
# Upstash Redis (production) or local Redis (development)
REDIS_URL=redis://localhost:6379

# ─── API Gateway ─────────────────────────────────────────────────────────────
PORT=8080
JWT_SECRET=change-me-to-a-long-random-secret-minimum-32-chars
JWT_EXPIRY=15m
REFRESH_EXPIRY=168h
ENV=development

# ─── Worker ──────────────────────────────────────────────────────────────────
PROJECT_ID=your-project-uuid-here
WORKER_QUEUES=default,email,notifications
WORKER_CONCURRENCY=5
POLL_INTERVAL=500ms
HEARTBEAT_INTERVAL=10s

# ─── Frontend ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8080

# ─── Local Postgres (docker-compose only) ────────────────────────────────────
POSTGRES_PASSWORD=djqsecret
