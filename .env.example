# Copy to .env and fill in. `./scripts/dev.sh` loads this file and passes every
# value to the API, the worker and the dashboard, so one file configures all three.

# ─── Database ───────────────────────────────────────────────────────────────
# Managed Postgres (Neon, RDS, …) or local Postgres. When the host is localhost,
# ./scripts/dev.sh starts the docker-compose postgres + redis for you.
DATABASE_URL=postgresql://djq:djqsecret@localhost:5432/disjobqueue?sslmode=disable

# ─── Cache / Rate limiting ──────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── API Gateway ────────────────────────────────────────────────────────────
PORT=8080
JWT_SECRET=change-me-generate-with-openssl-rand-base64-32
JWT_EXPIRY=15m
REFRESH_EXPIRY=168h
ENV=development

# ─── Worker ─────────────────────────────────────────────────────────────────
# PROJECT_ID is the project whose queues this worker serves (see /api/v1/projects).
PROJECT_ID=00000000-0000-0000-0000-000000000000
WORKER_QUEUES=default
WORKER_CONCURRENCY=5
POLL_INTERVAL=500ms
HEARTBEAT_INTERVAL=10s

# ─── Frontend ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8080
WEB_PORT=3000

# ─── Local Postgres (docker-compose only) ───────────────────────────────────
POSTGRES_PASSWORD=djqsecret
