DATABASE_URL=postgresql://djq:djqsecret@localhost:5432/disjobqueue?sslmode=disable

REDIS_URL=redis://localhost:6379

PORT=8080
JWT_SECRET=change-me-generate-with-openssl-rand-base64-32
JWT_EXPIRY=15m
REFRESH_EXPIRY=168h
ENV=development

# Optional: enables AI-generated failure summaries (Groq, OpenAI-compatible).
# GROQ_API_KEY=
# AI_SUMMARY_MODEL=openai/gpt-oss-20b

PROJECT_ID=00000000-0000-0000-0000-000000000000
# WORKER_QUEUES unset = poll every queue in the project automatically.
# Set it (comma-separated names) only to scope a worker to specific queues.
WORKER_CONCURRENCY=15
POLL_INTERVAL=500ms
HEARTBEAT_INTERVAL=10s

NEXT_PUBLIC_API_URL=http://localhost:8080
WEB_PORT=3000

POSTGRES_PASSWORD=djqsecret
